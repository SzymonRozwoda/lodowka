<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:text="Twoje produkty:"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewFoodItems"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />
    </LinearLayout>

    <!-- Nakładka przyciemniająca tło przy otwartym menu FAB -->
    <View
        android:id="@+id/fab_menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <!-- Kontener na wysuwane opcje -->
    <LinearLayout
        android:id="@+id/fab_menu_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Status powiadomienia -->
        <TextView
            android:id="@+id/alarmStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="?attr/colorSurfaceContainer"
            android:padding="4dp"
            android:elevation="4dp"
            android:text="Status alarmu"
            android:textColor="@color/green_primary"
            android:textStyle="italic" />

        <!-- Opcja Motyw -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zmień motyw"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorSurfaceContainer"
                android:padding="4dp"
                android:elevation="4dp"/>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_menu_compass" />
        </LinearLayout>

        <!-- Opcja Ustawienia -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ustawienia"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorSurfaceContainer"
                android:padding="4dp"
                android:elevation="4dp"/>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_menu_manage" />
        </LinearLayout>

        <!-- Opcja Włącz/Wyłącz Powiadomienia -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/text_toggle_notifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wyłącz powiadomienia"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorSurfaceContainer"
                android:padding="4dp"
                android:elevation="4dp"/>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_toggle_notifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_lock_silent_mode" />
        </LinearLayout>

        <!-- Opcja Godzina Powiadomienia -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ustaw godzinę"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorSurfaceContainer"
                android:padding="4dp"
                android:elevation="4dp"/>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_set_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_lock_idle_alarm" />
        </LinearLayout>

        <!-- Opcja Dodaj -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dodaj produkt"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorSurfaceContainer"
                android:padding="4dp"
                android:elevation="4dp"/>
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_add_item"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:fabSize="mini"
                app:srcCompat="@android:drawable/ic_input_add" />
        </LinearLayout>
    </LinearLayout>

    <!-- Główny przycisk FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        app:srcCompat="@android:drawable/ic_dialog_dialer" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
